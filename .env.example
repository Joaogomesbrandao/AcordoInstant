# --- Rede e contrato ---------------------------------------------------------
# Rede de testes local levantada com `npm run chain` (npx hardhat node).
RPC_URL=http://127.0.0.1:8545
# Opcional: obrigatorio so se o RPC exigir um chainId explicito (ex.: redes
# publicas). Sem isso, o ethers detecta automaticamente pela rede.
CHAIN_ID=31337
# Endereco impresso por `npm run deploy:local` (tambem gravado em
# deployments/<rede>.json). Na rede local ele e deterministico:
# 0x5FbDB2315678afecb367f032d93F642f64180aa3 para o primeiro deploy do no.
CONTRACT_ADDRESS=endereco_do_contrato_implantado

# --- Carteira da companhia aerea ---------------------------------------------
# Carteira unica da companhia: o backend assina com ela todas as acoes do
# painel da companhia (depositar/resgatar fundo, cadastrar voo, inscrever
# passageiro) e o registro oficial de atraso. Sem isso, as rotas /companhia/*
# respondem com erro 503 em vez de travar.
# Precisa ser a MESMA conta que assinou o deploy, porque o contrato usa
# msg.sender como dona do voo. Na rede local, use a Account #0 impressa pelo
# `npm run chain` (chave publica e conhecida: nunca reutilize fora do local).
OPERATOR_PRIVATE_KEY=chave_privada_da_carteira_da_companhia

# 3001 por padrao: o frontend (Vite) ja ocupa a porta 3000.
PORT=3001

# --- Sepolia (opcional) ------------------------------------------------------
# Usados apenas por `npm run deploy:sepolia`. A conta precisa de ETH de faucet.
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/sua_chave
# SEPOLIA_PRIVATE_KEY=0x...
