# URL do backend (backend/server.js). Deixe em branco/comentado em
# desenvolvimento: o Vite já redireciona as chamadas para o backend na porta
# 3001 (ver vite.config.ts). Só preencha se o backend estiver rodando em
# outro endereço.
# VITE_API_URL=http://localhost:3001

# RPC usado só para LEITURAS diretas do contrato (consultarVoo,
# listarVoosDoPassageiro, calcularMulta...), não exige nenhuma carteira.
VITE_RPC_URL=http://127.0.0.1:8545

# Endereço do contrato SeguroParametrico.sol já implantado. Fixo por
# configuração: nenhuma tela do frontend pede ou mostra esse valor.
VITE_CONTRACT_ADDRESS=endereco_do_contrato_implantado
