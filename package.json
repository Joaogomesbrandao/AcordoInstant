{
  "name": "acordoinstant",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Seguro parametrico de atraso de voo em contrato inteligente. AcordoInstant (ESMA-PB 2026)",
  "scripts": {
    "chain": "mkdir -p logs && hardhat node 2>&1 | tee logs/hardhat-node.log",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run deploy/deploy.js --network localhost",
    "seed": "node deploy/seed.js",
    "dev": "concurrently -k -n backend,frontend -c yellow,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node backend/server.js",
    "reset": "node scripts/reset.js",
    "logs": "tail -f logs/blockchain.log"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.2",
    "ethers": "^6.15.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "hardhat": "^3.12.0"
  }
}
